{
  "name": "tessl-carnival",
  "schedules": {
    "doc-gardening": {
      "cron": "0 6 * * 1",
      "description": "Find docs and agent instructions that no longer match the code, and file one issue per stale doc.",
      "action": {
        "skill": "file:tessl-factory#doc-gardening",
        "environment": "tessl-carnival-loops",
        "agent": "claude-code",
        "model": "claude-sonnet-5-5"
      }
    }
  }
}
